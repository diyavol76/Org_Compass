{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-second-brain/recipe",
  "title": "Recipe frontmatter",
  "type": "object",
  "required": ["id", "type", "title", "status", "owner", "version", "phase", "loads", "checkpoints", "escalates_when", "done_when", "referenced_by", "last_reviewed"],
  "properties": {
    "id": {"type": "string", "pattern": "^rcp-[a-z0-9]+(-[a-z0-9]+)*$"},
    "type": {"const": "recipe"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "phase": {"type": "string", "minLength": 1},
    "loads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "calls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "checkpoints": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]+$"}},
    "escalates_when": {"type": "array", "items": {"type": "string"}},
    "done_when": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "referenced_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "additionalProperties": false
}
